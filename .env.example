# Scrixo environment variables
# Copy this file to `.env.local` and fill in values from your Supabase project.
# Dashboard: https://supabase.com/dashboard → Project Settings → API

# --- Required for the app to boot ---
# The browser and server clients in `src/lib/supabase.ts` and
# `src/lib/supabase-server.ts` both read these. If they are missing,
# `createBrowserClient` / `createServerClient` will throw.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- What Supabase is actually used for ---
#
# Guest sign flow (launch path): files stay in browser memory via Zustand.
# You can sign and download WITHOUT being logged in. Supabase is not
# load-bearing for that path, but the client is still constructed on
# every page that imports it (homepage header, editor, signature pad).
#
# Logged-in extras (keep wired, not required to launch signing):
# - Auth: Google OAuth (`supabase.auth.signInWithOAuth({ provider: "google" })`)
#   Enable Google under Authentication → Providers.
# - Storage bucket `pdfs`: saved documents for logged-in users
#   (`useDashboard` / `useEditor` upload+download).
# - Table `documents`: metadata for saved PDFs (id, name, file_path, user_id, updated_at).
# - Table `signatures`: saved signature images for logged-in users (`SignaturePad`).
#
# Confirm the existing project still has these objects and is not an
# orphaned Lovable/demo project before relying on Log In / Save.

# --- Waitlist (Google Sheet only — same pipeline as Subpoena Deadline Tracker) ---
# Temporary demand signal; remove later. Not stored in Supabase.
# Paste `scripts/google-sheet-waitlist.js` into the shared spreadsheet Apps Script,
# deploy as a web app, add "Scrixo" to ALLOWED_PROJECTS if that property is set.
GOOGLE_SHEETS_WEBHOOK_URL=
WAITLIST_PROJECT=Scrixo
WAITLIST_HEADERS=Timestamp,Email,Source
WAITLIST_SECRET=

# --- Not used at launch ---
# Paid send-feature / rate limiter (`UpgradeModal`, `src/lib/rate-limiter.ts`)
# is dormant until Phase 3. No extra env vars required for that yet.
